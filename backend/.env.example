# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/collegerag

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# AI provider (gemini | openrouter)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=google/gemini-2.0-flash-001

# Embeddings
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# Vector database (Pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=collegerag
PINECONE_NAMESPACE=default

# RAG tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=8
RERANK_ENABLED=true
RERANK_TOP_N=4
HYBRID_SEARCH_ENABLED=true
MIN_RELEVANCE_SCORE=0.3

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
